{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playwigo",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "playwigo"
    }
  ]
}
